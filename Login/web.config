<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <remove name="Content-Security-Policy" />
                <add name="Content-Security-Policy" value="style-src-attr 'unsafe-inline' 'self' ; img-src data: *.tile.openstreetmap.org https://*.creatio.com http://*.creatio.com https://*.bpmonline.com http://*.bpmonline.com 'self' ; prefetch-src 'self' ; script-src 'self' 'unsafe-eval' 'unsafe-inline' ; style-src 'self' 'unsafe-inline' ; script-src-attr 'self' 'unsafe-inline' ; connect-src https://*.creatio.com http://*.creatio.com https://*.bpmonline.com wss://*.bpmonline.com:* http://*.bpmonline.com 'self' ; font-src https://fonts.gstatic.com data: 'self' ; manifest-src 'self' ; worker-src 'self' ; frame-src http://*.bpmonline.com 'self' http://*.creatio.com https://*.creatio.com https://*.bpmonline.com; child-src http://*.creatio.com 'self' https://*.creatio.com ; frame-ancestors 'self' *.creatio.com *.tscrm.com; media-src 'self' ; style-src-elem https://fonts.googleapis.com 'self' 'unsafe-inline' ; object-src 'none' ; form-action 'self' ; " />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
