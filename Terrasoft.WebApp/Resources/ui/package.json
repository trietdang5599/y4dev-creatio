{
  "name": "bpm",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "karma": "karma start karma.conf.js --parallel",
    "karma:debug": "karma start karma.conf.js --browsers Chrome",
    "karma:cov": "karma start karma.conf.js --parallel --coverage --single-run",
    "karma:teamcity": "npm ci && karma start karma.conf.js --reporters teamcity --parallel --single-run --coverage false",
    "karma-coverage:teamcity": "npm ci && karma start karma.conf.js --reporters teamcity,coverage --single-run --coverage true",
    "ci": "npm ci --no-progress --no-audit --unsafe-perm --prefer-offline"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "drag-mock": "^1.4.0",
    "karma": "4.4.0",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "^2.0.1",
    "karma-jasmine": "^2.0.1",
    "karma-parallel": "^0.3.1",
    "karma-requirejs": "^1.1.0",
    "karma-spec-reporter": "0.0.32",
    "karma-summary-reporter": "^1.7.1",
    "karma-teamcity-reporter": "^1.1.0",
    "requirejs": "^2.3.6"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-plugin-jasmine": "^4.1.0",
    "eslint-plugin-spellcheck": "0.0.14",
    "file-loader": "^4.3.0"
  }
}
