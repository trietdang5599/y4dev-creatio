<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" autoReload="true" throwExceptions="false" >
	<include file="nlog.cloud.settings.config" />
	<targets>
		<wrapper-target xsi:type="AsyncWrapper" name="AdoNetBufferedAppender"
			queueLimit="10000"
			timeToSleepBetweenBatches="100"
			batchSize="100"
			overflowAction="Discard"
		>
			<target xsi:type="Database" name="AdoNetAppender" connectionString="${ConnectionString}" >
				<commandType>Text</commandType>
				<commandText>INSERT INTO [dbo].[log4net] ([Date],[Host],[Site],[Thread],[Level],[Logger],[User],[Message],[Exception], [MessageObject]) VALUES (@log_date, @log_host, @log_site, @log_thread, @log_level, @log_logger, @log_user, @log_message, @log_exception, @message_object)</commandText>
				<parameter name="@log_date" layout="${date}" />
				<parameter name="@log_host" size="255" layout="${machinename}" />
				<parameter name="@log_site" size="255" layout="${iis-site-name}" />
				<parameter name="@log_thread" size="255" layout="${threadid}" />
				<parameter name="@log_level" size="20" layout="${level}" />
				<parameter name="@log_logger" size="255" layout="${logger}" />
				<parameter name="@log_user" size="255" layout="${identity}" />
				<parameter name="@log_message" layout="${message}" />
				<parameter name="@log_exception" layout="${exception:format=ToString:innerFormat=ToString:maxInnerExceptionLevel=10}" />
				<parameter name="@message_object" layout="${messageObject}" />
			</target>
		</wrapper-target>
		<wrapper-target xsi:type="BufferingWrapper" name="BufferedGelfFileAppender"
			bufferSize="200"
			flushTimeout="120000" >
			<target name="GelfFileAppender" xsi:type="File" fileName="${LogDir}/${LogDay}/gelf.log">
				<layout xsi:type="GelfJsonLayout" facility="creatio">
					<attribute name="mesasgeObject" layout="${messageObject}" encode="false"/>
				</layout>
			</target>
		</wrapper-target>
	</targets>
	<rules>
		<logger name="Authentication" minlevel="Warn" writeTo="AdoNetBufferedAppender" final="true" />
		<logger name="ProcessExecutionTraceLog" minlevel="Info" writeTo="AdoNetBufferedAppender" final="true"/>
		<logger name="RedisSessionStateStoreProviderBlockingRequests" minlevel="Info" writeTo="AdoNetBufferedAppender" final="true" />
		<logger name="*" minlevel="Warn" writeTo="AdoNetBufferedAppender" />
		<!--<logger name="*" minlevel="Warn" writeTo="BufferedGelfFileAppender" />-->
		<logger name="TranslateProvider" writeTo="AdoNetBufferedAppender" minlevel="Error" final="true" />
		<logger name="TranslationService" writeTo="AdoNetBufferedAppender" minlevel="Error" final="true" />
		<logger name="InstallZipPackage" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="Build" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="ConfigurationBuild" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelContactIdentifier" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelChat" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelDetails" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelOperatorManager" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelMessageHandler" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelChatTransfer" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelMessaging" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelMessagingLib" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="OmnichannelSendMessageUserTask" writeTo="AdoNetBufferedAppender" minlevel="Error" final="true" />
		<logger name="Terrasoft.WebApp.Global" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="Redis" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="RedisMonitoring" minlevel="Warn" writeTo="AdoNetBufferedAppender" />
		<logger name="RedisTrafficMonitor" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="LDAP" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="Terrasoft.Core.Packages.PackageStorage" writeTo="AdoNetBufferedAppender" minlevel="Debug"/>
		<logger name="Terrasoft.Nui.ServiceModel.WebService.ClientUnitSchemaDesigner" writeTo="AdoNetBufferedAppender" minlevel="Info" final="true" />
		<logger name="Terrasoft.Core.SystemSettings.DbLoaders.DbSysAdminUnitLoader" writeTo="AdoNetBufferedAppender" minlevel="Info" final="true" />
		<logger name="MSWordLog" writeTo="AdoNetBufferedAppender" final="true" />
		<logger name="LegacyCookieTransformation" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="DesignerPresence" minlevel="Info" writeTo="AdoNetBufferedAppender" />
		<logger name="PerfClientLogger" minlevel="Debug" writeTo="AdoNetBufferedAppender" final="true" />
		<logger name="PerfServerLogger" minlevel="Debug" writeTo="AdoNetBufferedAppender" final="true" />
		<logger name="PerfSqlLogger" minlevel="Debug" writeTo="AdoNetBufferedAppender" final="true" />
	</rules>
</nlog>
